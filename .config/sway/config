# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

# Set mod key to win key
set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Roboto Regular 8

input type:keyboard {
    xkb_layout "eu"
}

output DP-1 resolution 1920x1080@60Hz position 0,0
output DP-2 resolution 2560x1440@144Hz position 1920,0
output HDMI-A-1 resolution 1920x1080@60Hz position 4480,0

set $bg_path "$HOME/Pictures/tokyo_night.png"
output HDMI-A-1 bg $bg_path stretch
output DP-2 bg $bg_path stretch
output DP-1 bg $bg_path stretch

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
# Use "update-alternatives --config x-terminal-emulator" change the terminal emulator
bindsym $mod+Return exec alacritty

# kill focused window
bindsym $mod+Shift+q kill

# start rofi (a program launcher, dmenu like)
bindsym $mod+d exec wmenu-run

# change focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# change focus, but with VIM curser keys
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Move focused window, but with VIM curser keys
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# toggle window splitting
bindsym $mod+v split toggle

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent
# focus the child container
#bindsym $mod+d focus child

# switch to workspace
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# Move Workspaces
bindsym $mod+Control+Left move workspace to output left
bindsym $mod+Control+Right move workspace to output right

# same but with vim shortcuts
bindsym $mod+Control+h move workspace to output left
bindsym $mod+Control+l move workspace to output right

# reload the configuration file
bindsym $mod+Shift+r reload

# resize window (you can also use the mouse for that)
mode "resize" {
    # These bindings trigger as soon as you enter the resize mode

    # Bindings for changing windows size
    bindsym l resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym h resize grow width 10 px or 10 ppt

    # same bindings, but for the arrow keys
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# Color settings
set $fg     #c0caf5
set $bg     #16161d
set $prim   #9aa5ce
set $warn   #f7768e

# class                 border  backgr. text indicator child_border
client.focused          $prim   $bg     $fg  $prim     $prim
client.focused_inactive $bg     $bg     $fg  $bg       $bg
client.unfocused        $bg     $bg     $fg  $bg       $bg
client.urgent           $bg     $bg     $fg  $bg       $bg
client.placeholder      $warn   $bg     $fg  $warn     $warn

client.background       $bg

# Give all windows a border
for_window [class="^.*"] border pixel 2

# Enable gaps
gaps inner 6px
smart_gaps on

# Only show popups / new floating windows when there belong to the currently focused app
popup_during_fullscreen smart
# Don't auto focus windows, just mark them as urgent
focus_on_window_activation urgent

# Open the Browser with a docker services open port
#bindsym $mod+shift+d exec $HOME/.config/polybar/launch-service.sh

# Screenshot, shortcut is the same as windows one
bindsym $mod+shift+s exec flameshot gui

# Lock screen
bindsym Control+Shift+l exec swaylock -f -c 282828

bar {
    position top

    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.
    status_command while date +'%Y-%m-%d %X'; do sleep 1; done

    colors {
        statusline #c0caf5
        background $bg
	# class            border    backgr.   text
        focused_workspace  $prim     $prim     $fg
        active_workspace   #414868   #414868   $fg
        inactive_workspace #414868   #414868   $fg
        urgent_workspace   $warn     $warn     $fg
    }
}

# Window overwrites
# Flameshot force float
for_window [app_id="flameshot"] floating enable


include /etc/sway/config.d/*
